# Google Tag Manager container ID (optional)
# Leave empty to disable tagging. For SSG, set this at build time.
# Local `nuxt dev` never loads GTM even if this is set.
NUXT_PUBLIC_SCRIPTS_GOOGLE_TAG_MANAGER_ID=

# Optional site branding overrides (prefer site.meta.yaml for defaults)
# NUXT_PUBLIC_SITE_NAME=Doc Site
# NUXT_PUBLIC_SITE_URL=https://example.com
# NUXT_PUBLIC_SITE_VERSION=0.9.0
# NUXT_PUBLIC_GITHUB_URL=https://github.com/b4moss/example
# NUXT_PUBLIC_FOOTER_TEXT=MIT License · 2026 Bicycle for Mind LLC.
