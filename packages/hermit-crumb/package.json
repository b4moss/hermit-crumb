{
  "name": "@b4moss/hermit-crumb",
  "version": "0.1.0",
  "description": "Nuxt v4 tech documentation site shell (module + CLI)",
  "type": "module",
  "license": "MIT",
  "author": "Bicycle for Mind LLC",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "documentation",
    "docs",
    "pico-css",
    "i18n"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4moss/hermit-crumb.git",
    "directory": "packages/hermit-crumb"
  },
  "bugs": {
    "url": "https://github.com/b4moss/hermit-crumb/issues"
  },
  "homepage": "https://github.com/b4moss/hermit-crumb#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "site.meta.yaml.example"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "typecheck": "nuxt-module-build build",
    "lint": "node ./scripts/lint.mjs"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "@picocss/pico": "^2.1.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@nuxt/content": "^3.14.0",
    "@nuxt/scripts": "^1.3.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^9.5.6",
    "nuxt": "^4.5.2"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^22.18.1",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.2"
  }
}
